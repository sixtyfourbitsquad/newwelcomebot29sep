{
    email {$ACME_EMAIL}
}
{$APP_DOMAIN} {
    @webhook {
        method POST
        path /telegram/webhook/*
    }
    handle @webhook {
        request_body {
            max_size 256KB
        }
        reverse_proxy app:8080
    }
    # Admin API is reachable only through an SSH tunnel to the private container network.
    handle {
        respond "Not found" 404
    }
}
