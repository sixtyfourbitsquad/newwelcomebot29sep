# --- Telegram ---
BOT_TOKEN=123456:YOUR_BOT_TOKEN

# Public HTTPS URL where nginx terminates TLS (no trailing slash)
WEBHOOK_BASE_URL=https://bot.example.com

# Path template; must match FastAPI route + nginx location
WEBHOOK_PATH=/tg/webhook/{secret}

# Secret segment used in webhook URL (high entropy)
WEBHOOK_SECRET=change-me-long-random-string

# Optional: Telegram setWebhook secret_token header validation
# TELEGRAM_WEBHOOK_SECRET_TOKEN=

# Set false only for local dev without a public HTTPS URL (skips setWebhook)
# WEBHOOK_REGISTER_ON_STARTUP=true

# Comma-separated Telegram user ids: each receives user forwards in private chat with the bot
ADMIN_USER_IDS=123456789,987654321

# Optional: seed first owner when admins table empty (Telegram user id)
INITIAL_OWNER_ID=123456789

# --- PostgreSQL (asyncpg DSN) ---
POSTGRES_DSN=postgresql://tg_bot:strongpassword@postgres:5432/tg_bot

# --- Redis ---
REDIS_URL=redis://redis:6379/0

# --- HTTP bind (inside container usually 8000) ---
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO

# Docker Compose only. The installer sets this to false and runs workers in their own containers.
# Leave true for a single local process.
# RUN_EMBEDDED_WORKERS=true

# Used by docker-compose.yml. Keep this the same password as POSTGRES_DSN.
POSTGRES_USER=tg_bot
POSTGRES_PASSWORD=strongpassword
POSTGRES_DB=tg_bot

# --- Throughput tuning ---
BROADCAST_CONCURRENCY=25
BROADCAST_CHUNK_SIZE=500
USER_MESSAGE_RATE_PER_MINUTE=30
ADMIN_REPLY_RATE_PER_MINUTE=120
LIVESTREAM_COOLDOWN_SECONDS=300

# --- Pools ---
POSTGRES_POOL_MIN=2
POSTGRES_POOL_MAX=20

# --- Redis keys ---
REDIS_BROADCAST_QUEUE=broadcast:jobs
REDIS_SCHEDULER_QUEUE=scheduler:jobs
REDIS_FSM_PREFIX=fsm:
REDIS_RATE_PREFIX=rate:
REDIS_LIVESTREAM_PREFIX=livestream:
# Leave-channel drip schedule (use a unique key per bot if Redis is shared)
# REDIS_RETENTION_ZSET=retention:due

STORAGE_DIR=./storage

# Post-/start onboarding drip jobs in Postgres (+1h/+1d/+3d templates); set false to disable
ONBOARDING_DRIP_ENABLED=true

# Optional path for “download full log” in admin panel (plain text file)
# LOG_FILE_PATH=/var/log/telegram-bot.log

# JSON logs (default keeps the existing text format)
# LOG_JSON=false

# Optional error tracking. Install sentry-sdk and set a DSN. Leave empty to disable.
# SENTRY_DSN=

# --- Web admin panel (separate HTTPS domain) ---
# Leave false until ADMIN_PANEL_URL, the bot username, and a 32+ character session secret are set.
WEB_ADMIN_ENABLED=false
ADMIN_PANEL_URL=https://admin.example.com
TELEGRAM_LOGIN_BOT_USERNAME=your_bot_username
WEB_SESSION_SECRET=
WEB_SESSION_EXPIRE_HOURS=24
WEB_COOKIE_SECURE=true
WEB_COOKIE_SAMESITE=lax
# Reject Telegram login payloads older than this many seconds
# TELEGRAM_AUTH_MAX_AGE_SECONDS=86400
# Optional second factor for owner accounts. Leave empty to skip.
# WEB_OWNER_PIN=
# Optional comma-separated IPs. Empty means no IP restriction.
# WEB_ADMIN_IP_ALLOWLIST=
# Optional bearer token required to scrape /metrics
# METRICS_TOKEN=
# Reject webhooks when TELEGRAM_WEBHOOK_SECRET_TOKEN is unset
# WEBHOOK_REQUIRE_SECRET_TOKEN=false
# WEBHOOK_MAX_BODY_BYTES=2000000
# CONFIG_CACHE_TTL_SECONDS=30
# REDIS_STREAM_PREFIX=jobs:
